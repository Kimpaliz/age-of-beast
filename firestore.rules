/* Scotophobia besitzt drei ausdrücklich begrenzte Firestore-Sammlungen:

   - zugriffsanfragen: Ein Google-Konto beantragt einmalig den Zugang.
     Nur das verifizierte Admin-Konto darf alle offenen Anfragen lesen und
     von „offen“ auf „bestaetigt“ setzen.
   - rueckmeldungen und feedbackquoten: Nur freigeschaltete Konten dürfen
     atomar bis zu drei Rückmeldungen je Berliner Kalenderwoche schreiben.
     Nur das verifizierte Admin-Konto liest die privaten Nachrichten.
   - feedbackbewertungen: Der Admin schreibt eine vollständige, neutrale
     Roadmap-Bewertung. Freigeschaltete Konten lesen ausschließlich deren
     angenommene Fassung, nie Namen oder Originaltexte.
   - spielstaende: Nur freigeschaltete Konten lesen oder schreiben ihren
     eigenen Pfad.

   Damit ist die Freigabe nicht nur eine Browseranzeige. Ein nicht
   bestätigtes Konto kann die Seite verändern, wie es will, erhält aber von
   Firestore weder Schreib- noch Leserechte für Spielzustand und Feedback. */

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function angemeldet() {
      return request.auth != null;
    }

    function istAdmin() {
      return angemeldet()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'kimpaliz1989@gmail.com';
    }

    function istFreigeschaltet() {
      return angemeldet() && (
        istAdmin()
        || (
          exists(/databases/$(database)/documents/zugriffsanfragen/$(request.auth.uid))
          && get(/databases/$(database)/documents/zugriffsanfragen/$(request.auth.uid))
              .data.status == 'bestaetigt'
        )
      );
    }

    /* Der Wochen-Schlüssel ist immer Montag, 00:00 Uhr in Berlin. Er wird
       als Datum bei 00:00 UTC gespeichert, damit Browser und Regel dieselbe
       einfache Zahl vergleichen können. Die Sommerzeit beginnt und endet in
       Berlin am letzten Sonntag im März beziehungsweise Oktober, jeweils
       01:00 UTC. */
    function letzterSonntag(jahr, monat) {
      let monatsende = timestamp.date(jahr, monat, 31);
      let versatz = monatsende.dayOfWeek() == 7 ? 0 : monatsende.dayOfWeek();
      return monatsende - duration.value(versatz, 'd');
    }

    function istBerlinerSommerzeit() {
      let jahr = request.time.year();
      let beginn = letzterSonntag(jahr, 3) + duration.value(1, 'h');
      let ende = letzterSonntag(jahr, 10) + duration.value(1, 'h');
      return request.time >= beginn && request.time < ende;
    }

    function feedbackWoche() {
      let berlin = request.time + duration.value(istBerlinerSommerzeit() ? 2 : 1, 'h');
      return berlin.date() - duration.value(berlin.dayOfWeek() - 1, 'd');
    }

    function quoteDatenGueltig(daten) {
      return daten.keys().hasOnly(['wochenbeginn', 'eintraege', 'aktualisiertAm'])
        && daten.keys().hasAll(['wochenbeginn', 'eintraege', 'aktualisiertAm'])
        && daten.wochenbeginn is timestamp
        && daten.eintraege is map
        && daten.eintraege.keys().size() > 0
        && daten.eintraege.keys().size() <= 3
        && daten.aktualisiertAm == request.time;
    }

    function quoteWurdeNeuAngelegt(konto, eintrag) {
      let quote = getAfter(/databases/$(database)/documents/feedbackquoten/$(konto)).data;
      return !exists(/databases/$(database)/documents/feedbackquoten/$(konto))
        && quoteDatenGueltig(quote)
        && quote.wochenbeginn == feedbackWoche()
        && quote.eintraege.keys().hasOnly([eintrag])
        && quote.eintraege[eintrag] == true;
    }

    function quoteWurdeErweitert(konto, eintrag) {
      let vorher = get(/databases/$(database)/documents/feedbackquoten/$(konto)).data;
      let nachher = getAfter(/databases/$(database)/documents/feedbackquoten/$(konto)).data;
      let aenderung = nachher.eintraege.diff(vorher.eintraege);
      return quoteDatenGueltig(nachher)
        && vorher.wochenbeginn == feedbackWoche()
        && nachher.wochenbeginn == feedbackWoche()
        && aenderung.addedKeys().hasOnly([eintrag])
        && aenderung.addedKeys().size() == 1
        && aenderung.removedKeys().size() == 0
        && aenderung.changedKeys().size() == 0
        && nachher.eintraege[eintrag] == true;
    }

    function feedbackQuoteStimmt(konto, eintrag) {
      return existsAfter(/databases/$(database)/documents/feedbackquoten/$(konto))
        && (
          quoteWurdeNeuAngelegt(konto, eintrag)
          || (exists(/databases/$(database)/documents/feedbackquoten/$(konto))
            && quoteWurdeErweitert(konto, eintrag))
        );
    }

    function istGueltigeFeedbackBewertung(daten) {
      return daten.keys().hasOnly([
          'status', 'art', 'titel', 'zusammenfassung', 'klassifikation',
          'wichtigkeit', 'komplexitaet', 'schritte', 'bewertetVon', 'bewertetAm'
        ])
        && daten.keys().hasAll([
          'status', 'art', 'titel', 'zusammenfassung', 'klassifikation',
          'wichtigkeit', 'komplexitaet', 'schritte', 'bewertetVon', 'bewertetAm'
        ])
        && daten.status == 'angenommen'
        && daten.art in ['Nutzerwunsch', 'Nutzeranregung', 'Nutzer-Bugmeldung']
        && daten.titel is string
        && daten.titel.size() >= 3
        && daten.titel.size() <= 140
        && daten.zusammenfassung is string
        && daten.zusammenfassung.size() >= 10
        && daten.zusammenfassung.size() <= 600
        && daten.klassifikation in ['Gameplay', 'Engine', 'Gemischt']
        && daten.wichtigkeit is int
        && daten.wichtigkeit >= 1
        && daten.wichtigkeit <= 5
        && daten.komplexitaet is int
        && daten.komplexitaet >= 1
        && daten.komplexitaet <= 5
        && daten.schritte is list
        && daten.schritte.size() >= 1
        && daten.schritte.size() <= 4
        && daten.bewertetVon == request.auth.uid
        && daten.bewertetAm == request.time;
    }

    /* ── Einmalige Zugriffsanfrage ────────────────────────────────── */
    match /zugriffsanfragen/{konto} {
      allow get: if angemeldet() && (request.auth.uid == konto || istAdmin());
      allow list: if istAdmin();

      allow create: if angemeldet()
        && request.auth.uid == konto
        && request.resource.data.keys().hasOnly([
          'konto', 'email', 'name', 'status', 'angefragtAm'
        ])
        && request.resource.data.keys().hasAll([
          'konto', 'email', 'name', 'status', 'angefragtAm'
        ])
        && request.resource.data.konto == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.status == 'offen'
        && request.resource.data.angefragtAm == request.time;

      /* Die Anfrage bleibt unverändert, außer dass Jannik sie genau einmal
         bestätigt und diese Entscheidung mit Zeit und Admin-Kennung versieht. */
      allow update: if istAdmin()
        && resource.data.status == 'offen'
        && request.resource.data.status == 'bestaetigt'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'bestaetigtAm', 'bestaetigtVon'])
        && request.resource.data.bestaetigtAm == request.time
        && request.resource.data.bestaetigtVon == request.auth.uid;

      allow delete: if false;
    }

    /* ── Rückmeldungen und Wochenkonto ─────────────────────────────── */
    match /rueckmeldungen/{eintrag} {
      allow read: if istAdmin();
      allow create: if istFreigeschaltet()
        && request.resource.data.keys().hasOnly([
          'konto', 'name', 'art', 'text', 'fassung', 'geraet', 'wochenbeginn', 'angekommen'
        ])
        && request.resource.data.keys().hasAll([
          'konto', 'name', 'art', 'text', 'fassung', 'geraet', 'wochenbeginn', 'angekommen'
        ])
        && request.resource.data.konto == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.art in ['gameplay', 'oberflaeche', 'welt', 'fehler']
        && request.resource.data.fassung is string
        && request.resource.data.fassung.size() <= 80
        && request.resource.data.geraet is string
        && request.resource.data.geraet.size() <= 40
        && request.resource.data.wochenbeginn == feedbackWoche()
        && feedbackQuoteStimmt(request.auth.uid, eintrag)
        && request.resource.data.angekommen == request.time;
      allow update, delete: if false;
    }

    /* Eine Bewertung ist die harte Grenze zwischen privatem Eingang und
       öffentlicher Roadmap. Das Formular kann „angenommen" nur mit allen
       Feldern absenden; die Regel erzwingt denselben Vertrag serverseitig. */
    match /feedbackbewertungen/{eintrag} {
      allow get, list: if istAdmin()
        || (istFreigeschaltet() && resource.data.status == 'angenommen');
      allow create: if istAdmin()
        && exists(/databases/$(database)/documents/rueckmeldungen/$(eintrag))
        && istGueltigeFeedbackBewertung(request.resource.data);
      allow update: if istAdmin()
        && istGueltigeFeedbackBewertung(request.resource.data);
      allow delete: if false;
    }

    match /feedbackquoten/{konto} {
      allow get: if istFreigeschaltet() && request.auth.uid == konto;
      allow list: if false;
      allow create: if istFreigeschaltet()
        && request.auth.uid == konto
        && quoteDatenGueltig(request.resource.data)
        && request.resource.data.wochenbeginn == feedbackWoche()
        && request.resource.data.eintraege.keys().size() == 1;
      allow update: if istFreigeschaltet()
        && request.auth.uid == konto
        && quoteDatenGueltig(request.resource.data)
        && (
          (
            resource.data.wochenbeginn == feedbackWoche()
            && request.resource.data.wochenbeginn == feedbackWoche()
            && request.resource.data.eintraege.diff(resource.data.eintraege)
              .addedKeys().size() == 1
            && request.resource.data.eintraege.diff(resource.data.eintraege)
              .removedKeys().size() == 0
            && request.resource.data.eintraege.diff(resource.data.eintraege)
              .changedKeys().size() == 0
          )
          || (
            resource.data.wochenbeginn < feedbackWoche()
            && request.resource.data.wochenbeginn == feedbackWoche()
            && request.resource.data.eintraege.keys().size() == 1
          )
        );
      allow delete: if false;
    }

    /* ── Spielstände ──────────────────────────────────────────────── */
    match /spielstaende/{konto} {
      allow read, write: if istFreigeschaltet() && request.auth.uid == konto;
    }

    /* ==================================================================
       Ab hier: Age-of-Beast-Wiki — NICHT ENTFERNEN
       ==================================================================

       Diese Bloecke gehoeren nicht zu Scotophobia. Sie stehen hier,
       weil Firestore pro Datenbank genau **eine** Regeldatei hat und
       der Spark-Plan keine zweite Datenbank erlaubt.

       Wer sie entfernt und die Datei veroeffentlicht, schaltet das Wiki
       ab: Weltdaten und Freigaben sind dann nicht mehr lesbar. Der
       Deploy meldet dabei Erfolg.

       Das ist am 04.09.2026 **viermal** passiert, weil hier eine
       Teilfassung ohne diese Bloecke lag. Deshalb liegt die
       vollstaendige Fassung jetzt in beiden Repositories, und
       `werkzeuge/pruefe-firestore-wiki.mjs` haelt sie fest.

       Die Trennung bleibt streng: Das Wiki hat eigene Sammlungen
       (wiki_*) und eigene Freigabefunktionen. Wer bei Scotophobia
       freigeschaltet ist, darf dadurch nicht das Wiki bearbeiten.
       ================================================================== */
    /* ==================================================================
       Age-of-Beast-Wiki
       ==================================================================

       Grundsatz: Das Wiki benutzt istFreigeschaltet() bewusst nicht,
       sondern hat eigene Hilfsfunktionen und mit wiki_zugang eine eigene
       Freigabesammlung. Eine Bestätigung bei Scotophobia öffnet damit
       nicht das Wiki, und eine Bestätigung im Wiki öffnet nicht
       Scotophobia. Teilten sich beide eine Funktion, wäre ein einziger
       Eintrag in der falschen Sammlung genug, um die jeweils andere
       Anwendung mit aufzuschließen — und niemand würde es bemerken,
       weil nichts kaputtgeht, sondern nur zu viel erlaubt ist. */

    function wikiAngemeldet() {
      return request.auth != null;
    }

    /* Dass dasselbe Konto beide Anwendungen verwaltet, ist eine Tatsache
       über Jannik und keine gemeinsame Logik. Die Bedingung steht hier
       eigens, damit eine spätere Änderung an Scotophobias Admin nicht
       stillschweigend mitbestimmt, wer das Wiki bearbeiten darf. */
    function istWikiAdmin() {
      return wikiAngemeldet()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'kimpaliz1989@gmail.com';
    }

    function istWikiSchreiber() {
      return wikiAngemeldet() && (
        istWikiAdmin()
        || (
          exists(/databases/$(database)/documents/wiki_zugang/$(request.auth.uid))
          && get(/databases/$(database)/documents/wiki_zugang/$(request.auth.uid))
              .data.status == 'bestaetigt'
        )
      );
    }

    /* ── Weltdaten ──────────────────────────────────── */

    /* Lesen ist für alle offen, und das ist Absicht: Das Wiki ist eine
       öffentliche Leseseite, die ihre Welt ohne Anmeldung über die
       REST-Schnittstelle holt. Dieselben Texte liegen ohnehin offen im
       GitHub-Repository. Eine Anmeldepflicht würde hier also nichts
       schützen, sondern nur die Besucheransicht zerstören.

       Geschrieben wird dagegen nur von bestätigten Konten, und jedes
       Dokument muss dabei die vollständige erwartete Form haben. Ein
       Schreibvorgang, der Felder erfindet oder weglässt, wird abgewiesen,
       bevor er die Welt beschädigt — die Zusammensetzung beim Lesen
       bricht ab, sobald ein Dokument nicht mehr passt.

       geaendertVon und geaendertAm setzt nicht der Browser, sondern die
       Regel. Sonst könnte ein Schreiber eine fremde Kennung oder ein
       falsches Datum eintragen und die Herkunft einer Änderung
       verschleiern.

       Die Grenze für inhalt: Das größte echte Modul misst gemessene
       264.079 Zeichen. 500.000 lassen der Welt Luft zum Wachsen und
       bleiben zugleich weit unter Firestores harter Grenze von 1 MiB je
       Dokument. Die Regel fängt den Unfall damit früher ab, und zwar mit
       einer Aussage über die Größe statt mit einer Ablehnung, deren
       Grund niemand sieht. */
    match /wiki_welt/{dokument} {
      allow read: if true;

      allow create, update: if istWikiSchreiber()
        && request.resource.data.keys().hasOnly([
          'inhalt', 'stand', 'geaendertAm', 'geaendertVon'
        ])
        && request.resource.data.keys().hasAll([
          'inhalt', 'stand', 'geaendertAm', 'geaendertVon'
        ])
        && request.resource.data.inhalt is string
        && request.resource.data.inhalt.size() > 0
        && request.resource.data.inhalt.size() <= 500000
        && request.resource.data.stand is string
        && request.resource.data.stand.size() > 0
        && request.resource.data.stand.size() <= 120
        && request.resource.data.geaendertVon == request.auth.uid
        && request.resource.data.geaendertAm == request.time;

      /* Ein Modul verschwindet nicht, es wird überschrieben. Löschen
         wäre der einzige Weg, die Welt unwiederbringlich zu zerreißen:
         Beim Lesen wird sie aus allen Dokumenten zusammengesetzt, und ein
         fehlendes Dokument bricht diesen Vorgang ab. */
      allow delete: if false;
    }

    /* ── Freigabe zum Bearbeiten ──────────────────────── */

    /* Nach demselben Muster wie Scotophobias Zugriffsanfragen, aber als
       eigener Block auf einer eigenen Sammlung. Ein Konto beantragt
       einmalig den Zugang, und nur Jannik setzt ihn von offen auf
       bestaetigt. Ein Antragsteller sieht seinen eigenen Antrag, aber
       nicht die der anderen — die Liste sieht nur der Admin.

       Entscheidend ist, was hier nicht steht: kein Verweis auf
       zugriffsanfragen. Genau diese fehlende Zeile ist die Trennung. */
    match /wiki_zugang/{konto} {
      allow get: if wikiAngemeldet() && (request.auth.uid == konto || istWikiAdmin());
      allow list: if istWikiAdmin();

      allow create: if wikiAngemeldet()
        && request.auth.uid == konto
        && request.resource.data.keys().hasOnly([
          'konto', 'email', 'name', 'status', 'angefragtAm'
        ])
        && request.resource.data.keys().hasAll([
          'konto', 'email', 'name', 'status', 'angefragtAm'
        ])
        && request.resource.data.konto == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.status == 'offen'
        && request.resource.data.angefragtAm == request.time;

      /* Der Antrag bleibt unverändert, außer dass Jannik ihn genau
         einmal bestätigt. Dass ausschließlich der Übergang von offen
         nach bestaetigt erlaubt ist, verhindert beides: das stille
         Zurücknehmen einer Freigabe und das erneute Bestätigen mit
         geänderten Nebenfeldern. */
      allow update: if istWikiAdmin()
        && resource.data.status == 'offen'
        && request.resource.data.status == 'bestaetigt'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'bestaetigtAm', 'bestaetigtVon'])
        && request.resource.data.bestaetigtAm == request.time
        && request.resource.data.bestaetigtVon == request.auth.uid;

      allow delete: if false;
    }


    /* ══ Plattform: mehrere Wikis ═══════════════════════════════════

       Jedes Wiki ist ein Dokument unter `wikis/` mit seinen Weltdaten
       als Untersammlung. Warum überhaupt so:

       **Ein neues Wiki darf keinen Deploy auslösen.** Firestore hat pro
       Datenbank genau eine Regeldatei, und ihr Deploy trifft auch
       Scotophobia (siehe docs/PROJEKTGRENZE.md). Deshalb sprechen diese
       Regeln über `{wikiId}` statt über feste Namen — ein Wiki anzulegen
       ist ein gewöhnlicher Schreibvorgang.

       **Die Mitgliedschaft steht auf dem Wiki-Dokument, nicht in einer
       Untersammlung.** Zwei Gründe, beide praktisch: Ein `get()` in einer
       Regel kostet einen Lesevorgang und ist auf zehn je Anfrage
       begrenzt; und „meine Wikis" liesse sich über eine Untersammlung
       gar nicht abfragen. Mit `mitgliederIds` als Feld genügt ein
       `array-contains`.

       **`rollen` ist eine Map uid → Rolle.** Sie steht neben
       `mitgliederIds`, weil eine Map sich nicht abfragen und ein Array
       sich nicht nach Rollen auswerten lässt. Beide müssen zueinander
       passen; das erzwingt `wikiMitgliedschaftStimmig()`.
       ══════════════════════════════════════════════════════════════ */

    /* ⚠️ **Jede Funktion des Wikis faengt mit `wiki` oder `istWiki` an.**
       Das ist keine Kosmetik: `pruefe-firestore-trennung.mjs` ordnet
       Funktionen nach genau diesem Praefix zu, wenn Scotophobias Repo
       nicht danebenliegt — auf dem Bauserver ist das immer so. Hiessen
       sie `darfWikiLesen`, haelt der Waechter sie fuer Scotophobias
       Funktionen und meldet die Trennung als verletzt. Genau das ist am
       04.09.2026 passiert und hat die Veroeffentlichung angehalten. */
    function wikiDoku(wikiId) {
      return get(/databases/$(database)/documents/wiki_projekte/$(wikiId)).data;
    }

    function wikiRolle(wikiId) {
      return wikiAngemeldet()
        ? wikiDoku(wikiId).rollen.get(request.auth.uid, '')
        : '';
    }

    function wikiDarfLesen(wikiId) {
      return wikiDoku(wikiId).oeffentlich == true
        || wikiRolle(wikiId) in ['besitzer', 'schreiber', 'leser'];
    }

    function wikiDarfSchreiben(wikiId) {
      return wikiRolle(wikiId) in ['besitzer', 'schreiber'];
    }

    function istWikiBesitzer(wikiId) {
      return wikiRolle(wikiId) == 'besitzer';
    }

    /* Array und Map dürfen nicht auseinanderlaufen: Wer in `rollen`
       steht, aber nicht in `mitgliederIds`, hätte Rechte, die niemand
       findet — und umgekehrt stünde jemand in der Liste, dessen Rolle
       leer ist. */
    function wikiMitgliedschaftStimmig(d) {
      return d.mitgliederIds is list
        && d.rollen is map
        && d.mitgliederIds.size() == d.rollen.keys().size()
        && d.rollen.keys().hasOnly(d.mitgliederIds)
        && d.mitgliederIds.hasOnly(d.rollen.keys())
        && d.mitgliederIds.size() >= 1
        && d.mitgliederIds.size() <= 200;
    }

    function wikiFelderStimmen(d) {
      return d.keys().hasOnly([
          'name', 'beschreibung', 'oeffentlich', 'regelwerke',
          'mitgliederIds', 'rollen', 'erstelltAm', 'erstelltVon'
        ])
        && d.keys().hasAll([
          'name', 'beschreibung', 'oeffentlich', 'regelwerke',
          'mitgliederIds', 'rollen', 'erstelltAm', 'erstelltVon'
        ])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.beschreibung is string && d.beschreibung.size() <= 600
        && d.oeffentlich is bool
        && d.regelwerke is list && d.regelwerke.size() <= 20
        && wikiMitgliedschaftStimmig(d);
    }

    match /wiki_projekte/{wikiId} {
      /* Ein einzelnes Wiki liest, wer Mitglied ist — oder jeder, wenn es
         öffentlich ist. Für `list` prüft Firestore dieselbe Bedingung
         gegen die Abfrage: Eine Liste kommt nur durch, wenn sie sich auf
         `oeffentlich == true` oder auf `mitgliederIds` mit der eigenen
         Kennung beschränkt. Eine Abfrage „alle Wikis" scheitert damit von
         selbst, ohne dass hier eine Sonderregel nötig wäre. */
      allow read: if resource.data.oeffentlich == true
        || (wikiAngemeldet() && request.auth.uid in resource.data.mitgliederIds);

      /* Wer ein Wiki anlegt, ist sein Besitzer — und zwar allein. Ein
         Anlegen, das gleich Fremde einträgt, wäre der bequemste Weg,
         jemandem ungefragt ein Wiki unterzuschieben. */
      allow create: if wikiAngemeldet()
        && wikiFelderStimmen(request.resource.data)
        && request.resource.data.erstelltVon == request.auth.uid
        && request.resource.data.erstelltAm == request.time
        && request.resource.data.mitgliederIds == [request.auth.uid]
        && request.resource.data.rollen[request.auth.uid] == 'besitzer';

      /* Ändern darf der Besitzer. Was er **nicht** darf: sich selbst
         herausschreiben — dann gäbe es ein Wiki ohne Besitzer, das
         niemand mehr verwalten kann. */
      allow update: if istWikiBesitzer(wikiId)
        && wikiFelderStimmen(request.resource.data)
        && request.resource.data.erstelltVon == resource.data.erstelltVon
        && request.resource.data.erstelltAm == resource.data.erstelltAm
        && request.resource.data.rollen[request.auth.uid] == 'besitzer';

      allow delete: if istWikiBesitzer(wikiId);

      /* ── Die Welt dieses Wikis ── */
      match /welt/{teil} {
        allow read: if wikiDarfLesen(wikiId);

        allow create, update: if wikiDarfSchreiben(wikiId)
          && request.resource.data.keys().hasOnly([
            'inhalt', 'stand', 'geaendertAm', 'geaendertVon'
          ])
          && request.resource.data.keys().hasAll([
            'inhalt', 'stand', 'geaendertAm', 'geaendertVon'
          ])
          && request.resource.data.inhalt is string
          && request.resource.data.inhalt.size() > 0
          && request.resource.data.inhalt.size() <= 500000
          && request.resource.data.stand is string
          && request.resource.data.stand.size() > 0
          && request.resource.data.stand.size() <= 120
          && request.resource.data.geaendertVon == request.auth.uid
          && request.resource.data.geaendertAm == request.time;

        /* Ein Modul verschwindet nicht, es wird überschrieben — sonst
           zerreisst die Welt beim Zusammensetzen. Ein ganzes Wiki
           loescht der Besitzer über sein Dokument. */
        allow delete: if false;
      }
    }

    /* Andere Anwendungen im Firebase-Projekt verwenden Firestore nicht.
       Jede nicht ausdrücklich genannte Sammlung bleibt geschlossen. */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
